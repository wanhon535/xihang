{
  "name": "tidesail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "vite --host 127.0.0.1 --port 2223 --strictPort",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node backend/src/server.js",
    "check": "node --check backend/src/server.js",
    "build:frontend": "vite build",
    "test:user-scenarios": "node scripts/user-scenario-smoke.mjs && node scripts/admin-module-smoke.mjs",
    "verify:refactor": "node scripts/verify-after-refactor.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
