PORT=2222
FRONTEND_ORIGIN=http://127.0.0.1:2223,http://localhost:2223
SESSION_SECRET=replace-with-a-long-random-secret
# 个人密码库加密密钥。上线后生成一个长随机值并固定保存，变更后历史记录无法解密。
VAULT_ENCRYPTION_KEY=replace-with-another-long-random-secret

# 本平台账号密码登录，用于管理员后台；上线请改强密码。
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123456

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=tidesail

# 钉钉开放平台 OAuth2 登录应用配置
# 新版后台显示为 Client ID / Client Secret；旧写法 DINGTALK_APP_ID / DINGTALK_APP_SECRET 仍兼容。
DINGTALK_CLIENT_ID=dingxxxxxxxxxxxx
DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DINGTALK_OAUTH_SCOPE=openid corpid Contact.User.Read
DINGTALK_OAUTH_PROMPT=consent
DINGTALK_APP_ID=
DINGTALK_APP_SECRET=
DINGTALK_OPEN_APP_ID=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
DINGTALK_API_TOKEN=

# 必须和钉钉开放平台里配置的回调域名/地址一致
DINGTALK_REDIRECT_URI=http://127.0.0.1:2222/api/auth/dingtalk/callback
# 钉钉后台只配置 IPv4 白名单时保持开启，避免 Node 优先使用 IPv6 出口导致 60020。
DINGTALK_FORCE_IPV4=true

# 可选：只允许指定 unionId 登录，多个用英文逗号分隔；留空表示通过钉钉登录成功即可访问。
ALLOWED_DINGTALK_UNION_IDS=

# 后台管理员配置：优先使用 unionId；也可以临时用昵称识别，默认昵称 admin 为管理员。
ADMIN_DINGTALK_UNION_IDS=
ADMIN_DINGTALK_NICKS=admin

# SSO ticket 有效期，单位秒。目标系统需在有效期内调用 /api/sso/verify 消费 ticket。
SSO_TICKET_TTL_SECONDS=120
